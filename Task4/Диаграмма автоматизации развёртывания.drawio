        <mxCell id="m1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=10;fillColor=#dddddd;strokeColor=#666666;" value="&lt;b&gt;M1. Организация в консоли Yandex Cloud&lt;/b&gt;&lt;hr/&gt;• Облако, каталог (folder_id)&lt;br/&gt;• Биллинг, привязка платёжного средства&lt;br/&gt;• Квоты при необходимости" vertex="1">
          <mxGeometry height="110" width="348" x="56" y="252" as="geometry" />
        </mxCell>
        <mxCell id="m2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=10;fillColor=#dddddd;strokeColor=#666666;" value="&lt;b&gt;M2. CLI и доступ&lt;/b&gt;&lt;hr/&gt;• Установка &lt;b&gt;yc&lt;/b&gt;, &lt;b&gt;yc init&lt;/b&gt; (OAuth)&lt;br/&gt;• Профиль: cloud-id, folder-id" vertex="1">
          <mxGeometry height="80" width="348" x="56" y="378" as="geometry" />
        </mxCell>
        <mxCell id="m3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=10;fillColor=#dddddd;strokeColor=#666666;" value="&lt;b&gt;M3. Учётные данные для API&lt;/b&gt;&lt;hr/&gt;• &lt;b&gt;export YC_TOKEN=$(yc iam create-token)&lt;/b&gt;&lt;br/&gt;(токен не хранить в Git)" vertex="1">
          <mxGeometry height="80" width="348" x="56" y="474" as="geometry" />
        </mxCell>
        <mxCell id="m4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=10;fillColor=#dddddd;strokeColor=#666666;" value="&lt;b&gt;M4. SSH&lt;/b&gt;&lt;hr/&gt;• &lt;b&gt;ssh-keygen&lt;/b&gt; → публичный ключ в &lt;b&gt;terraform.tfvars&lt;/b&gt;&lt;br/&gt;• Пароль на ключ (опционально), &lt;b&gt;ssh-add&lt;/b&gt;" vertex="1">
          <mxGeometry height="90" width="348" x="56" y="570" as="geometry" />
        </mxCell>
        <mxCell id="m5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=10;fillColor=#dddddd;strokeColor=#666666;" value="&lt;b&gt;M5. Пост-деплой (по необходимости)&lt;/b&gt;&lt;hr/&gt;• Внешний DNS, мониторинг вне Terraform&lt;br/&gt;• Скриншот &lt;b&gt;terraform apply&lt;/b&gt; для отчёта/PR" vertex="1">
