        <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#fff9e6;strokeColor=#d6b656;fontSize=11;" value="&lt;b&gt;Легенда&lt;/b&gt;&lt;br&gt;Зелёный — ресурс в &lt;b&gt;main.tf&lt;/b&gt; (IaC)&lt;br&gt;Серый — действия &lt;b&gt;вне&lt;/b&gt; Terraform&lt;br&gt;Оранжевый — процесс CLI (локально)&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" vertex="1">
